# PostgreSQL connection string (Neon or Supabase). Prisma reads this for every query and migration.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign the `rubis_session` JWT cookie. Must be a long random string (32+ chars).
# Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Vercel Blob read/write token for photo + signature uploads.
# Vercel injects this automatically once a Blob store is attached to the project.
# Leave unset in local development — uploads then fall back to ./.local-uploads/.
BLOB_READ_WRITE_TOKEN=""

# Resend API key used to email a stocktake summary to info@pure-nutritions.com the
# moment a stocktake is saved. Leave unset to disable this email (submissions still work).
RESEND_API_KEY=""

# Optional: sender address for the stocktake email. Must be on a domain verified in
# Resend. Defaults to Resend's shared test sender if unset.
RESEND_FROM_EMAIL=""

# Odoo sync: when a branch manager uploads an LPO, mirror their current reorder as a
# draft Sales Order in Odoo. Leave any of these unset to disable sync (LPO uploads
# still work — this is a bonus, never blocks the upload itself).
ODOO_URL=""
ODOO_DB=""
ODOO_USERNAME=""
ODOO_API_KEY=""
