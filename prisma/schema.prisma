// Rubis Enjoy — Stock & Reorder
// Production target: PostgreSQL (Neon / Supabase).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MovementType {
  DELIVERY
  SALE
  RETURN
  EXPIRED_DAMAGED
}

enum Audience {
  ALL
  COUNTY
  TYPE
  STORE
}

enum RoleCodeType {
  MERCHANDISER
  MANAGER
  HQ
}

model Store {
  /// Matches the original seeded ids 1-75; new branches autoincrement from there.
  id     Int    @id @default(autoincrement())
  name    String
  type    String // "CODO" | "COCO"
  county  String
  /// Physical address, branch-manager self-service (like contactPhone/contactEmail).
  address String @default("")

  /// Contact info as it arrived in the original seed data.
  seedPhone String @default("")
  seedEmail String @default("")

  /// bcrypt hash of the derived branch code ("RB" + zero-padded 3-digit id).
  codeHash String

  /// Branch-manager self-service overrides (shown with a green * in the admin table).
  contactPhone String?
  contactEmail String?

  managerPhotoUrl String?
  managerName     String?

  approvalStatus String    @default("pending") // "pending" | "approved"
  approvalAt     DateTime?

  /// Matching Odoo res.partner id (mapped once, manually reviewed — Odoo customer
  /// names don't always match the app's branch names 1:1).
  odooPartnerId Int?

  createdAt DateTime @default(now())

  /// Bumped on every authenticated page load, so the manager can see which branches are active.
  lastActiveAt DateTime?

  stocktakes    Stocktake[]
  movements     Movement[]
  lpoDocuments  LpoDocument[]
  messages   Message[]

  @@index([county])
}

model Product {
  sku      String  @id
  barcode  String  @default("")
  range    String // "Classic Range" | "Indulge Range" | "Gourmet Range"
  flavour  String
  price    Int // KES
  /// Editable by the Pure Nutrition manager; floored to MIN_STOCK in the reorder calc only.
  target   Int
  unavailable Boolean @default(false)

  stocktakeItems StocktakeItem[]
  movements      Movement[]
}

model Merchandiser {
  id       String   @id @default(cuid())
  name     String
  codeHash String   @unique
  active   Boolean  @default(true)
  createdAt DateTime @default(now())

  /// Bumped on every authenticated page load, so the manager can see which merchandisers are active.
  lastActiveAt DateTime?
}

model RoleCode {
  type      RoleCodeType @id
  codeHash  String
  updatedAt DateTime     @updatedAt
}

/// A branch manager's uploaded LPO (Local Purchase Order) document — a PDF or a
/// photo of a paper LPO. Not tied to a specific computed reorder, since "an order"
/// has no stable row of its own in this system; just a dated file per branch.
model LpoDocument {
  id         String   @id @default(cuid())
  storeId    Int
  url        String
  filename   String
  uploadedAt DateTime @default(now())

  /// Set once a matching draft Sales Order is created in Odoo (id and human-readable
  /// name, e.g. "S00042"). Null if Odoo sync isn't configured or the branch has no
  /// mapped Odoo customer yet.
  odooSaleOrderId   Int?
  odooSaleOrderName String?

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

model Stocktake {
  id      String @id @default(cuid())
  storeId Int
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Visit date the merchandiser picked — "YYYY-MM-DD", not necessarily today.
  date         String
  /// Time the merchandiser started the visit — "HH:MM", 24h. Blank for branch
  /// managers' own embedded self-service stocktake (not required there).
  visitTime    String @default("")
  merchandiser String
  idNumber     String @default("")
  /// Merchandiser's own phone — optional, not required, for payment purposes.
  merchandiserPhone String @default("")
  /// Merchandiser's KRA PIN — required for every merchandiser visit (not the
  /// branch manager's own embedded stocktake).
  kraPin       String @default("")
  /// Required for every stocktake.
  signatureUrl String
  notes        String @default("")

  checksPlacement String? // "Yes" | "No"
  checksPrices    String?
  checksMissing   String?
  checksPromotion String?
  checksNotes     String  @default("")

  placementPhotoUrl String?
  pricesPhotoUrl    String?

  promotionType     String  @default("")
  promotionPhotoUrl String?

  competitorBrands   String  @default("")
  competitorPhotoUrl String?

  /// Structured competitor entries (brand + gram + description + price + own
  /// photo), required for merchandiser visits since it must always be exactly
  /// 3. competitorBrands/competitorPhotoUrl above are kept in sync (joined
  /// brand list + 1st photo) so older reporting code that reads those still works.
  competitorBrand1      String?
  competitorGram1       String?
  competitorDescription1 String?
  competitorPrice1      Float?
  competitorPhotoUrl1   String?
  competitorBrand2      String?
  competitorGram2       String?
  competitorDescription2 String?
  competitorPrice2      Float?
  competitorPhotoUrl2   String?
  competitorBrand3      String?
  competitorGram3       String?
  competitorDescription3 String?
  competitorPrice3      Float?
  competitorPhotoUrl3   String?

  /// True when any product row carried a photo.
  photoTaken Boolean @default(false)
  /// True when submitted from the Branch Manager's own self-service Stocktake tab.
  embedded   Boolean @default(false)

  createdAt DateTime @default(now())

  items StocktakeItem[]

  @@index([storeId, date])
}

model StocktakeItem {
  id          String    @id @default(cuid())
  stocktakeId String
  stocktake   Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)

  sku     String
  product Product @relation(fields: [sku], references: [sku])

  shelfQty  Int     @default(0)
  backStock Int     @default(0)
  expired   Int     @default(0)
  damaged   Int     @default(0)
  batchCode String  @default("")
  photoUrl  String?

  @@index([stocktakeId])
}

model Movement {
  id      String @id @default(cuid())
  storeId Int
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Null for a Delivery — that type is logged as paperwork only (note/invoice/
  /// photo), not tied to a specific product/quantity.
  sku     String?
  product Product? @relation(fields: [sku], references: [sku])

  type      MovementType
  qty       Int
  date      String // "YYYY-MM-DD"
  /// Time the movement was logged — "HH:MM", 24h. Optional.
  time      String @default("")
  batchCode String       @default("")
  /// Only relevant for type DELIVERY, optional.
  deliveryNote         String  @default("")
  deliveryNotePhotoUrl String?
  invoiceNumber        String  @default("")
  /// Name of the person at the branch who received the order.
  receivedBy           String  @default("")
  notes     String       @default("")
  /// Required before submitting — enforced in the app, not the DB, matching
  /// idNumber/kraPin so existing rows don't need a value.
  signatureUrl String @default("")
  createdAt DateTime     @default(now())

  @@index([storeId, date])
  @@index([type, date])
}

model Message {
  id       String   @id @default(cuid())
  subject  String
  body     String
  audience Audience
  county   String?
  storeType String?
  storeId  Int?
  store    Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)

  from          String   @default("Rubis Head Office")
  autoReminder  Boolean  @default(false)
  reminderMonth String? // "YYYY-MM", used to dedupe the automated month-end reminder
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model MonthlyReward {
  monthKey String  @id // "YYYY-MM"
  note     String  @default("")
  sent     Boolean @default(false)
}
